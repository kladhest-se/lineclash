# LineClash Windows server example. Copy to a chosen --config path.
# Omitted database/log paths use %APPDATA%\LineClash\Server.
port = 31457
server_name = LineClash
num_lobbies = 3
max_players_per_room = 8
allow_bots = 1
require_registered = 0
status_api = 1
status_port = 31458

# Announce to the public directory; set off for a private server.
public_server = on

# Automatic public IPv4 detection; optional override: public_ip = 203.0.113.10
# Local discovery uses UDP 31459; disable on private/shared networks if desired.
lan_discovery = on
