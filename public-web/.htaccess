Options -Indexes
RewriteEngine On
# Resolve PIN routes internally before mod_dir can expose a proxy backend port.
# PHP sends the canonical root-relative redirect, preserving the public origin.
RewriteRule ^pin$ pin/index.php [END]
RewriteRule ^account/pin$ account/pin/index.php [END]
RewriteRule ^(?:inc|bin)(?:/|$) - [F,L]
RewriteRule ^\.?config.*\.php.*$ - [F,L,NC]
<FilesMatch "(?i)^(\.?config.*\.php.*|\.env(?:\..*)?|.*\.local\.php.*)$">
    Require all denied
</FilesMatch>
